GROQ_API_KEY=your_key_here
# 호출량이 많은 모든 곳(캐시 미스마다 재생성되는 날씨/환율/뉴스 3개 브리핑
# 섹션, 뉴스 헤드라인 번역)에서 쓰는 모델 — 쿼터가 넉넉한 소형 모델이 기본값.
# GROQ_MODEL=llama-3.1-8b-instant
# 정확도가 더 필요한 곳에만 아껴 쓰는 모델 — 로또 AI 인사이트(최대 주 1회)와,
# GROQ_MODEL의 출력이 콘텐츠 검증(한자/일본어 문자 혼입, 번역 안 된 영어 잔존,
# 숫자 단위 오역 등)에 실패했을 때의 단 한 번뿐인 재시도 용도.
# GROQ_ESCALATION_MODEL=llama-3.3-70b-versatile

# NewsData.io (뉴스 섹션 — 무료 키 발급 방법은 README 참고)
NEWSDATA_API_KEY=your_key_here

# 기상청 단기예보 API — 국내 도시 날씨(무료 키 발급 방법은 README 참고).
# data.go.kr이 발급하는 "일반 인증키(Encoding)"를 써야 한다 — 이미 URL
# 인코딩된 값이라 코드가 쿼리스트링에 그대로 이어붙인다. "Decoding" 키를
# 넣으면 이중 인코딩되어 인증에 실패한다. 이 키가 없으면 국내 도시도
# 자동으로 Open-Meteo로 대체된다.
# KMA_SERVICE_KEY=your_key_here

# Turso(libSQL) — 로또 섹션 + 모든 원본 데이터/브리핑/뉴스 번역 캐시의
# 영속 저장소(무료 DB 생성 방법은 README 참고). 로컬 개발 시에는 계정 없이
# 둘 다 비워두면 된다 — 서버가 자동으로 backend/data/dashboard.db 파일로
# 폴백한다.
# TURSO_DATABASE_URL=libsql://your-db-name-your-username.turso.io
# TURSO_AUTH_TOKEN=your_token_here
# TURSO_DATABASE_URL이 비어있을 때만 쓰인다 — 로컬 파일 DB의 경로를
# 바꾼다(기본값: backend/data/dashboard.db). 주로 테스트용.
# LOCAL_DB_PATH=data/dashboard.db

# 로또 dhlottery 수집은 환경변수가 아니라 화면의 ON/OFF 토글로 런타임에
# 제어한다(POST /api/lotto/collection/start|stop). 서버가 시작할 때마다
# 항상 꺼진 상태로 시작하며, 토글(또는 위 엔드포인트)로 켜고 꺼야 한다.
# 수집 pass 중 dhlottery 회차 조회 동시 요청 수 상한. dhlottery가 요청이
# 몰리면 이후 요청을 조용히 드롭하는 것으로 보여 기본값을 낮게 잡았다 —
# 더 높은 값이 안전한지 직접 확인한 뒤에만 올릴 것.
# LOTTO_FETCH_CONCURRENCY=2
