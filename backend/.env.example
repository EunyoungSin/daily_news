GROQ_API_KEY=your_key_here
# 호출량이 많은 모든 곳(캐시 미스마다 재생성되는 날씨/환율/뉴스 3개 브리핑
# 섹션, 뉴스 헤드라인 번역)에서 쓰는 모델 — 더 빠르고 저렴한 소형 모델이
# 기본값. (2026-08) 원래 기본값이던 llama-3.1-8b-instant는 Groq에서 완전히
# 지원 종료되어 openai/gpt-oss-20b로 교체했다. 이 모델과 아래
# GROQ_ESCALATION_MODEL은 무료 티어 한도가 동일하다(30 RPM · 1,000 RPD ·
# 8,000 TPM · 200,000 TPD — https://console.groq.com/docs/rate-limits) —
# 예전 llama-3.1-8b-instant의 14,400 req/day처럼 여유로운 쿼터가 아니므로,
# GET /api/debug/groq-usage로 실제 호출량을 가끔 확인해두면 좋다.
# GROQ_MODEL=openai/gpt-oss-20b
# 정확도가 더 필요한 곳에만 아껴 쓰는 모델 — 로또 AI 인사이트(최대 주 1회)와,
# GROQ_MODEL의 출력이 콘텐츠 검증(한자/일본어 문자 혼입, 번역 안 된 영어 잔존,
# 숫자 단위 오역 등)에 실패했을 때의 단 한 번뿐인 재시도 용도. (2026-08)
# 원래 기본값이던 llama-3.3-70b-versatile도 Groq에서 지원 종료되어
# openai/gpt-oss-120b로 교체했다.
# GROQ_ESCALATION_MODEL=openai/gpt-oss-120b

# NewsData.io (뉴스 섹션 — 무료 키 발급 방법은 README 참고)
NEWSDATA_API_KEY=your_key_here

# 기상청 단기예보 API — 국내 도시 날씨(무료 키 발급 방법은 README 참고).
# data.go.kr이 발급하는 "일반 인증키(Encoding)"를 써야 한다 — 이미 URL
# 인코딩된 값이라 코드가 쿼리스트링에 그대로 이어붙인다. "Decoding" 키를
# 넣으면 이중 인코딩되어 인증에 실패한다. 이 키가 없으면 국내 도시도
# 자동으로 Open-Meteo로 대체된다.
# KMA_SERVICE_KEY=your_key_here

# Turso(libSQL) — 로또 섹션 + 모든 원본 데이터/브리핑/뉴스 번역 캐시의
# 영속 저장소(무료 DB 생성 방법은 README 참고). 로컬 개발 시에는 계정 없이
# 둘 다 비워두면 된다 — 서버가 자동으로 backend/data/dashboard.db 파일로
# 폴백한다.
# TURSO_DATABASE_URL=libsql://your-db-name-your-username.turso.io
# TURSO_AUTH_TOKEN=your_token_here
# TURSO_DATABASE_URL이 비어있을 때만 쓰인다 — 로컬 파일 DB의 경로를
# 바꾼다(기본값: backend/data/dashboard.db). 주로 테스트용.
# LOCAL_DB_PATH=data/dashboard.db

# 로또 자동 수집(GitHub 데이터셋에서 밀린 회차를 채우고, 이후로는 매주
# 최신 회차 1개만 확인)은 기본적으로 서버 시작 시 곧바로 켜진다. 화면의
# "매주 자동 업데이트" 토글(또는 POST /api/lotto/collection/start|stop)로
# 런타임에 껐다 켤 수도 있다. 초기 데이터는 backend/data/lotto_seed.json
# 시드 파일로 채운다(README 참고).
# LOTTO_AUTO_COLLECTION_DEFAULT=on으로 서버가 시작할 때마다 자동으로 켜진다
# (기본값). off로 설정하면 예전처럼 항상 꺼진 상태로 시작하며, 화면의
# 토글을 직접 눌러야만 켜진다.
# LOTTO_AUTO_COLLECTION_DEFAULT=off

# 로또 관리자 API(POST /api/admin/lotto/manual-entry, GET
# /api/admin/lotto/status) 인증 키 — dhlottery가 막혔을 때 회차를 수동으로
# 채워 넣는 대체 수단이다(README의 "관리자 API" 참고). 프론트엔드 화면
# 어디에도 노출되지 않으며, curl/scripts/manual_lotto_entry.sh로만
# 호출한다. 비워두면 두 엔드포인트 모두 503을 반환하며 비활성화된다.
# ADMIN_SECRET_KEY=your_secret_here
