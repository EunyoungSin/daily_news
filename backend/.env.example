GROQ_API_KEY=your_key_here
# Model for the lotto AI insight (speed-optimized; low-stakes content).
# GROQ_MODEL=llama-3.1-8b-instant
# Model for news headline translation AND the AI briefing (all 3 sections)
# — accuracy (numbers, word order, no stray Chinese/Japanese characters)
# matters more here than speed, so this defaults to a bigger model.
# GROQ_TRANSLATE_MODEL=llama-3.3-70b-versatile

# NewsData.io (news section — see README for how to get a free key)
NEWSDATA_API_KEY=your_key_here

# KMA (기상청) short-term forecast API — domestic city weather (see
# README for how to get a free key). Use the "Encoding"(인코딩) service
# key data.go.kr issues, not the "Decoding" one — it's already
# URL-encoded and the code appends it to the query string as-is, so a
# raw/decoded key would end up double-encoded and rejected. Without this
# key, domestic cities fall back to Open-Meteo automatically.
# KMA_SERVICE_KEY=your_key_here

# MySQL (lotto section persistence — see README for Docker / Aiven setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dashboard
DB_PASSWORD=dashboard_pw
DB_NAME=dashboard
# Set to true for cloud MySQL (Aiven etc.) that requires an encrypted connection.
DB_USE_TLS=false
# Optional: path to the provider's CA cert (e.g. Aiven's downloadable ca.pem).
# Without it, DB_USE_TLS=true still encrypts the connection but skips server
# certificate verification.
# DB_CA_CERT_PATH=/path/to/ca.pem

# Set to false to completely disable the lotto section and its background
# dhlottery collection (e.g. while dhlottery is blocking requests) without a
# redeploy. The lotto card shows a "점검 중" notice instead. Defaults to
# enabled if unset.
# LOTTO_ENABLED=false
